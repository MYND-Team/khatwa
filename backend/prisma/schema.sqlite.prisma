// Prisma schema — SQLite variant for LOCAL DEV (no PostgreSQL required)
// For production, use schema.prisma with provider = "postgresql"

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client-sqlite"
}

datasource db {
  provider = "sqlite"
}

model AccessCode {
  id           String   @id @default(cuid())
  codeHash     String   @unique
  points       Int      @default(0)
  status       String   @default("ACTIVE")
  expiresAt    DateTime?
  createdById  String?
  redeemedById String?
  redeemedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  transactions PointsTransaction[]
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentProfile          StudentProfile?
  teacherProfile          TeacherProfile?
  refreshTokens           RefreshToken[]
  walletBalance           Float               @default(0.0)
  pointsBalance           Int                 @default(0)
  pointsTransactions      PointsTransaction[] @relation("StudentTransactions")
  actedPointsTransactions PointsTransaction[] @relation("ActorTransactions")
  walletTransactions      WalletTransaction[] @relation("StudentWalletTransactions")
  actedWalletTransactions WalletTransaction[] @relation("ActorWalletTransactions")
  videoAccessLogs         VideoAccessLog[]
  quizAttempts            QuizAttempt[]
  homeworkSubmissions     HomeworkSubmission[]
  unlockedLessons         UnlockedLesson[]
  courseEnrollments       CourseEnrollment[]
  lessonSubscriptions     LessonSubscription[]
  paymentTransactions     PaymentTransaction[]
  studentNotes            StudentNote[]       @relation("StudentReceivedNotes")
  authoredNotes           StudentNote[]       @relation("AuthorWrittenNotes")
  pointRequests           PointRequest[]
  notifications           Notification[]
}

model StudentProfile {
  id                 String      @id @default(cuid())
  userId             String      @unique
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentPhoneNumber String
  academicStage      String?     @default("SECONDARY_1")
  parentInfo         ParentInfo?
}

model ParentInfo {
  id                String         @id @default(cuid())
  studentProfileId  String         @unique
  studentProfile    StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  parentPhoneNumber String
  parentEmail       String?
  fatherJob         String
  parentStatus      String
}

model TeacherProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName    String
  bio            String?
  subject        String?
  avatarUrl      String?
  rating         Float    @default(5.0)
  ratingCount    Int      @default(1)
  academicStages String?

  workspaces          TeacherStage[]
  courses             Course[]
  lessons             Lesson[]
  subscriptions       LessonSubscription[]
  paymentTransactions PaymentTransaction[]
}

model TeacherStage {
  id               String         @id @default(cuid())
  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  stage            String
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())

  @@unique([teacherProfileId, stage])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Course {
  id                 String    @id @default(cuid())
  teacherProfileId   String
  teacherProfile     TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  title              String
  subject            String
  academicStage      String    @default("SECONDARY_1")
  imageUrl           String?
  description        String?
  pointCost          Int       @default(0)
  price              Float     @default(0.0)
  accessType         String    @default("PERMANENT")
  accessDurationDays Int?
  isPublished        Boolean   @default(true)
  
  chapters            Chapter[]
  lessons             Lesson[]
  enrollments         CourseEnrollment[]
  lessonSubscriptions LessonSubscription[]
  paymentTransactions PaymentTransaction[]

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Chapter {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  imageUrl    String?
  orderIndex  Int      @default(0)

  lessons     Lesson[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CourseEnrollment {
  id         String    @id @default(cuid())
  studentId  String
  student    User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime  @default(now())
  expiresAt  DateTime?

  @@unique([studentId, courseId])
}

model StudentNote {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation("StudentReceivedNotes", fields: [studentId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("AuthorWrittenNotes", fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id           String   @id @default(cuid())
  studentId    String
  student      User     @relation("StudentWalletTransactions", fields: [studentId], references: [id], onDelete: Cascade)
  type         String
  amount       Float
  balanceAfter Float
  reason       String
  actorId      String
  actor        User     @relation("ActorWalletTransactions", fields: [actorId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

model PointsTransaction {
  id              String      @id @default(cuid())
  studentId       String
  student         User        @relation("StudentTransactions", fields: [studentId], references: [id], onDelete: Cascade)
  type            String
  amount          Int
  reason          String
  relatedCodeId   String?
  relatedCode     AccessCode? @relation(fields: [relatedCodeId], references: [id])
  relatedLessonId String?
  relatedLesson   Lesson?     @relation(fields: [relatedLessonId], references: [id])
  actorId         String
  actor           User        @relation("ActorTransactions", fields: [actorId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())
}

model PointRequest {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedPoints Int       @default(0)
  amount          Float     @default(0.0)
  code            String?
  notes           String?
  screenshotUrl   String?
  status          String    @default("PENDING")
  processedById   String?
  processedAt     DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Lesson {
  id               String         @id @default(cuid())
  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  courseId         String?
  course           Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  chapterId        String?
  chapter          Chapter?       @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  academicStage    String         @default("SECONDARY_1")
  
  title            String
  description      String?
  pointCost        Int            @default(0)
  price            Float          @default(0.0)
  accessType       String         @default("PERMANENT")
  accessDurationDays Int?
  orderIndex       Int            @default(0)
  isPublished      Boolean        @default(true)

  videoUrl         String?
  driveFileId      String?
  driveFileName    String?
  pdfUrl           String?
  pdfFileName      String?

  assignmentQuizId String?
  assignmentQuiz   Quiz?   @relation("LessonAssignment", fields: [assignmentQuizId], references: [id])

  examQuizId       String?
  examQuiz         Quiz?   @relation("LessonExam", fields: [examQuizId], references: [id])

  openingQuizId    String?
  openingQuiz      Quiz?   @relation("OpeningQuiz", fields: [openingQuizId], references: [id])

  homeworkId       String?
  homework         Quiz?   @relation("Homework", fields: [homeworkId], references: [id])

  unlockedBy          UnlockedLesson[]
  subscriptions       LessonSubscription[]
  paymentTransactions PaymentTransaction[]
  pointsTransactions  PointsTransaction[]
  videoAccessLogs     VideoAccessLog[]
  playbackTokens      PlaybackToken[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model LessonSubscription {
  id               String         @id @default(cuid())
  studentId        String
  student          User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId         String
  lesson           Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  courseId         String?
  course           Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  academicStage    String         @default("SECONDARY_1")
  status           String         @default("ACTIVE")
  paymentMethod    String         @default("WALLET_EGP")
  pricePaid        Float          @default(0.0)
  pointsPaid       Int            @default(0)
  subscribedAt     DateTime       @default(now())
  expiresAt        DateTime?

  paymentTransaction PaymentTransaction?

  @@unique([studentId, lessonId])
}

model PaymentTransaction {
  id                   String              @id @default(cuid())
  transactionNumber    String              @unique
  studentId            String
  student              User                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherProfileId     String
  teacherProfile       TeacherProfile      @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  academicStage        String              @default("SECONDARY_1")
  courseId             String?
  course               Course?             @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lessonId             String?
  lesson               Lesson?             @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  lessonSubscriptionId String?             @unique
  lessonSubscription   LessonSubscription? @relation(fields: [lessonSubscriptionId], references: [id], onDelete: SetNull)
  amount               Float               @default(0.0)
  currency             String              @default("EGP")
  pointsUsed           Int                 @default(0)
  paymentMethod        String              @default("WALLET_EGP")
  teacherEarning       Float               @default(0.0)
  platformFee          Float               @default(0.0)
  status               String              @default("COMPLETED")
  createdAt            DateTime            @default(now())
}

model UnlockedLesson {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId   String
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  unlockedAt DateTime @default(now())

  @@unique([studentId, lessonId])
}

model PlaybackToken {
  id        String    @id @default(cuid())
  token     String    @unique
  lessonId  String
  lesson    Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model VideoAccessLog {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  ip        String
  createdAt DateTime @default(now())
}

model Quiz {
  id        String         @id @default(cuid())
  title     String
  type      String         @default("EXAM")
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  assignmentForLessons Lesson[] @relation("LessonAssignment")
  examForLessons       Lesson[] @relation("LessonExam")
  openingForLessons    Lesson[] @relation("OpeningQuiz")
  homeworkForLessons   Lesson[] @relation("Homework")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuizQuestion {
  id            String       @id @default(cuid())
  quizId        String
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionType  String       @default("MULTIPLE_CHOICE")
  questionText  String
  optionA       String?
  optionB       String?
  optionC       String?
  optionD       String?
  correctOption String?
  equationLatex String?
  sampleAnswer  String?
  rubric        String?
  orderIndex    Int             @default(0)
  answerLines   AttemptAnswer[]
}

model QuizAttempt {
  id             String          @id @default(cuid())
  studentId      String
  student        User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quizId         String
  quiz           Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score          Int             @default(0)
  totalQuestions Int             @default(0)
  passed         Boolean         @default(false)
  submittedAt    DateTime        @default(now())
  answers        AttemptAnswer[]

  @@unique([studentId, quizId])
}

model AttemptAnswer {
  id             String       @id @default(cuid())
  attemptId      String
  attempt        QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  question       QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption String?
  textAnswer     String?
  isCorrect      Boolean      @default(false)
}

model HomeworkSubmission {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId    String
  submittedAt DateTime @default(now())

  @@unique([studentId, lessonId])
}

model PlatformSettings {
  id                          String   @id @default(cuid())
  platformName                String   @default("خطوة")
  platformSubtitle            String?  @default("منصة التعليم الذكية")
  logoUrl                     String?
  primaryColor                String   @default("#6C63FF")
  secondaryColor              String   @default("#FF6584")
  accentColor                 String   @default("#F59E0B")
  fontFamily                  String   @default("Inter")
  pointsToEgpRate             Float    @default(1.0)
  defaultTeacherCommissionPct Float    @default(80.0)
  maintenanceMode             Boolean  @default(false)
  updatedAt                   DateTime @updatedAt
  updatedById                 String?
}
