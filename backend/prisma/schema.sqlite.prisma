// Prisma schema — SQLite variant for LOCAL DEV (no PostgreSQL required)
// For production, use schema.prisma with provider = "postgresql"

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client-sqlite"
}

datasource db {
  provider = "sqlite"
}

model AccessCode {
  id           String   @id @default(cuid())
  codeHash     String   @unique
  points       Int      @default(0)
  status       String   @default("ACTIVE")
  expiresAt    DateTime?
  createdById  String?
  redeemedById String?
  redeemedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  transactions PointsTransaction[]
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentProfile      StudentProfile?
  teacherProfile      TeacherProfile?
  refreshTokens       RefreshToken[]
  pointsBalance       Int                 @default(0)
  pointsTransactions  PointsTransaction[] @relation("StudentTransactions")
  actedTransactions   PointsTransaction[] @relation("ActorTransactions")
  videoAccessLogs     VideoAccessLog[]
  quizAttempts        QuizAttempt[]
  homeworkSubmissions HomeworkSubmission[]
  unlockedLessons     UnlockedLesson[]
  pointRequests       PointRequest[]
}

model StudentProfile {
  id                 String      @id @default(cuid())
  userId             String      @unique
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentPhoneNumber String
  parentInfo         ParentInfo?
}

model ParentInfo {
  id                String         @id @default(cuid())
  studentProfileId  String         @unique
  studentProfile    StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  parentPhoneNumber String
  parentEmail       String?
  fatherJob         String
  parentStatus      String         @default("BOTH_ALIVE")
}

model TeacherProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  bio         String?
  subject     String?
  lessons     Lesson[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PointsTransaction {
  id              String      @id @default(cuid())
  studentId       String
  student         User        @relation("StudentTransactions", fields: [studentId], references: [id])
  type            String
  amount          Int
  reason          String
  relatedCodeId   String?
  relatedCode     AccessCode? @relation(fields: [relatedCodeId], references: [id])
  relatedLessonId String?
  relatedLesson   Lesson?     @relation(fields: [relatedLessonId], references: [id])
  actorId         String
  actor           User        @relation("ActorTransactions", fields: [actorId], references: [id])
  createdAt       DateTime    @default(now())
}

model Lesson {
  id               String         @id @default(cuid())
  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  pointCost        Int            @default(0)
  orderIndex       Int            @default(0)
  isPublished      Boolean        @default(false)
  driveFileId      String?
  driveFileName    String?
  openingQuizId    String?
  openingQuiz      Quiz?          @relation("OpeningQuiz", fields: [openingQuizId], references: [id])
  homeworkId       String?
  homework         Quiz?          @relation("Homework", fields: [homeworkId], references: [id])
  unlockedBy         UnlockedLesson[]
  pointsTransactions PointsTransaction[]
  videoAccessLogs    VideoAccessLog[]
  playbackTokens     PlaybackToken[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model UnlockedLesson {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId   String
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  unlockedAt DateTime @default(now())

  @@unique([studentId, lessonId])
}

model PlaybackToken {
  id        String    @id @default(cuid())
  token     String    @unique
  lessonId  String
  lesson    Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model VideoAccessLog {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  ip        String
  createdAt DateTime @default(now())
}

model Quiz {
  id        String         @id @default(cuid())
  title     String
  type      String
  questions QuizQuestion[]
  attempts  QuizAttempt[]
  openingForLessons  Lesson[] @relation("OpeningQuiz")
  homeworkForLessons Lesson[] @relation("Homework")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuizQuestion {
  id            String          @id @default(cuid())
  quizId        String
  quiz          Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionText  String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String
  orderIndex    Int             @default(0)
  answerLines   AttemptAnswer[]
}

model QuizAttempt {
  id             String          @id @default(cuid())
  studentId      String
  student        User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quizId         String
  quiz           Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score          Int
  totalQuestions Int
  passed         Boolean
  submittedAt    DateTime        @default(now())
  answers        AttemptAnswer[]

  @@unique([studentId, quizId])
}

model AttemptAnswer {
  id             String       @id @default(cuid())
  attemptId      String
  attempt        QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  question       QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption String
  isCorrect      Boolean
}

model HomeworkSubmission {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId    String
  submittedAt DateTime @default(now())

  @@unique([studentId, lessonId])
}

model PlatformSettings {
  id             String   @id @default(cuid())
  platformName   String   @default("خطوة")
  logoUrl        String?
  primaryColor   String   @default("#6C63FF")
  secondaryColor String   @default("#FF6584")
  fontFamily     String   @default("Inter")
  updatedAt      DateTime @updatedAt
  updatedById    String?
}

// ─── Point Recharge Request (replaces access codes) ───────────────────────────
// Students upload a payment screenshot; staff/admin review and manually credit points.

model PointRequest {
  id              String   @id @default(cuid())
  studentId       String
  student         User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  requestedPoints Int
  screenshotPath  String
  screenshotName  String?
  notes           String?
  status          String   @default("PENDING")  // PENDING | APPROVED | REJECTED
  reviewedById    String?
  reviewedAt      DateTime?
  grantedPoints   Int?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

