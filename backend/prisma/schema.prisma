// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  STUDENT
  TEACHER
  STAFF
  ADMIN
}

enum ParentStatus {
  BOTH_ALIVE
  FATHER_DECEASED
  MOTHER_DECEASED
  BOTH_DECEASED
}

enum AccessCodeStatus {
  ACTIVE
  REDEEMED
  REVOKED
  EXPIRED
}

enum PointsTransactionType {
  CREDIT
  DEBIT
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum PointRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuizType {
  OPENING_QUIZ
  HOMEWORK
  EXAM
}

enum AcademicStage {
  PREPARATORY
  SECONDARY_1
  SECONDARY_2
  SECONDARY_3
}

enum CourseAccessType {
  PERMANENT
  LIMITED
}

enum QuestionType {
  MULTIPLE_CHOICE
  ESSAY
  EQUATION
}

// ─────────────────────────────────────────────
// ACCESS CODES (Points Access Codes)
// Generated by STAFF / ADMIN -> Redeemed by STUDENT
// ─────────────────────────────────────────────

model AccessCode {
  id           String           @id @default(cuid())
  codeHash     String           @unique // SHA-256 of the uppercase code; plaintext never stored in DB
  points       Int              @default(0)
  status       AccessCodeStatus @default(ACTIVE)
  expiresAt    DateTime?
  createdById  String?
  createdBy    User?            @relation("CreatedAccessCodes", fields: [createdById], references: [id])
  redeemedById String?
  redeemedBy   User?            @relation("RedeemedAccessCodes", fields: [redeemedById], references: [id])
  redeemedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  transactions PointsTransaction[]

  @@index([codeHash])
  @@index([createdById])
  @@index([redeemedById])
  @@index([status])
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Student-only fields
  studentProfile StudentProfile?

  // Teacher-only fields
  teacherProfile TeacherProfile?

  // Auth
  refreshTokens RefreshToken[]

  // Real Money & Points Balances
  walletBalance       Float               @default(0.0)
  pointsBalance       Int                 @default(0)
  
  pointsTransactions  PointsTransaction[] @relation("StudentTransactions")
  actedPointsTransactions PointsTransaction[] @relation("ActorTransactions")

  walletTransactions  WalletTransaction[] @relation("StudentWalletTransactions")
  actedWalletTransactions WalletTransaction[] @relation("ActorWalletTransactions")

  // Access codes created (STAFF / ADMIN) and redeemed (STUDENT)
  createdAccessCodes  AccessCode[]        @relation("CreatedAccessCodes")
  redeemedAccessCodes AccessCode[]        @relation("RedeemedAccessCodes")

  // Video access logs
  videoAccessLogs VideoAccessLog[]

  // Quiz & Exam attempts
  quizAttempts QuizAttempt[]

  // Homework submissions
  homeworkSubmissions HomeworkSubmission[]

  // Unlocked lessons (Legacy support)
  unlockedLessons UnlockedLesson[]

  // Course Enrollments (Legacy support)
  courseEnrollments CourseEnrollment[]

  // Lesson Subscriptions (Single source of truth for student lesson access)
  lessonSubscriptions LessonSubscription[]

  // Traceable Payment Transactions
  paymentTransactions PaymentTransaction[]

  // Student Notes
  studentNotes  StudentNote[] @relation("StudentReceivedNotes")
  authoredNotes StudentNote[] @relation("AuthorWrittenNotes")

  // Point requests & notifications
  pointRequests PointRequest[]
  notifications Notification[]

  @@index([role])
}

model StudentProfile {
  id                 String         @id @default(cuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentPhoneNumber String
  academicStage      AcademicStage? @default(SECONDARY_1)
  parentInfo         ParentInfo?
}

model ParentInfo {
  id                String         @id @default(cuid())
  studentProfileId  String         @unique
  studentProfile    StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  parentPhoneNumber String
  parentEmail       String?
  fatherJob         String
  parentStatus      ParentStatus // SENSITIVE — never include in general API responses
}

model TeacherProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName    String
  bio            String?
  subject        String?
  avatarUrl      String?
  rating         Float    @default(5.0)
  ratingCount    Int      @default(1)
  academicStages String?  // e.g. "PREPARATORY,SECONDARY_1,SECONDARY_2,SECONDARY_3"

  workspaces     TeacherStage[]
  courses        Course[]
  lessons        Lesson[]
  subscriptions  LessonSubscription[]
  paymentTransactions PaymentTransaction[]
}

// ─────────────────────────────────────────────
// TEACHER STAGE WORKSPACES
// ─────────────────────────────────────────────

model TeacherStage {
  id               String         @id @default(cuid())
  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  stage            AcademicStage
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())

  @@unique([teacherProfileId, stage])
  @@index([stage])
  @@index([teacherProfileId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// ─────────────────────────────────────────────
// COURSES & CHAPTERS (Academic Year Hierarchy)
// ─────────────────────────────────────────────

model Course {
  id                 String           @id @default(cuid())
  teacherProfileId   String
  teacherProfile     TeacherProfile   @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  title              String
  subject            String
  academicStage      AcademicStage    @default(SECONDARY_1)
  imageUrl           String?
  description        String?
  pointCost          Int              @default(0)
  price              Float            @default(0.0)
  accessType         CourseAccessType @default(PERMANENT)
  accessDurationDays Int?
  isPublished        Boolean          @default(true)
  
  chapters           Chapter[]
  lessons            Lesson[]
  enrollments        CourseEnrollment[]
  lessonSubscriptions LessonSubscription[]
  paymentTransactions PaymentTransaction[]

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([teacherProfileId])
  @@index([academicStage])
}

model Chapter {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  imageUrl    String?
  orderIndex  Int      @default(0)

  lessons     Lesson[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId])
  @@index([orderIndex])
}

model CourseEnrollment {
  id         String    @id @default(cuid())
  studentId  String
  student    User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime  @default(now())
  expiresAt  DateTime?

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────
// STUDENT NOTES
// ─────────────────────────────────────────────

model StudentNote {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation("StudentReceivedNotes", fields: [studentId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("AuthorWrittenNotes", fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([authorId])
}

// ─────────────────────────────────────────────
// WALLET & POINTS TRANSACTIONS
// ─────────────────────────────────────────────

model WalletTransaction {
  id           String                @id @default(cuid())
  studentId    String
  student      User                  @relation("StudentWalletTransactions", fields: [studentId], references: [id], onDelete: Cascade)
  type         WalletTransactionType
  amount       Float
  balanceAfter Float
  reason       String
  actorId      String
  actor        User                  @relation("ActorWalletTransactions", fields: [actorId], references: [id], onDelete: Cascade)
  createdAt    DateTime              @default(now())

  @@index([studentId])
  @@index([actorId])
}

model PointsTransaction {
  id               String                @id @default(cuid())
  studentId        String
  student          User                  @relation("StudentTransactions", fields: [studentId], references: [id], onDelete: Cascade)
  type             PointsTransactionType
  amount           Int
  reason           String
  relatedCodeId    String?
  relatedCode      AccessCode?           @relation(fields: [relatedCodeId], references: [id])
  relatedLessonId  String?
  relatedLesson    Lesson?               @relation(fields: [relatedLessonId], references: [id])
  actorId          String
  actor            User                  @relation("ActorTransactions", fields: [actorId], references: [id], onDelete: Cascade)
  createdAt        DateTime              @default(now())

  @@index([studentId])
  @@index([relatedCodeId])
}

model PointRequest {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedPoints Int                @default(0)
  amount          Float              @default(0.0)
  code            String?
  notes           String?
  screenshotUrl   String?
  status          PointRequestStatus @default(PENDING)
  processedById   String?
  processedAt     DateTime?
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────
// LESSONS (The purchasable product)
// ─────────────────────────────────────────────

model Lesson {
  id               String           @id @default(cuid())
  teacherProfileId String
  teacherProfile   TeacherProfile   @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  courseId         String?
  course           Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  chapterId        String?
  chapter          Chapter?         @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  academicStage    AcademicStage    @default(SECONDARY_1)
  
  title            String
  description      String?
  pointCost        Int              @default(0)
  price            Float            @default(0.0) // EGP price per lesson
  accessType       CourseAccessType @default(PERMANENT)
  accessDurationDays Int?
  orderIndex       Int              @default(0)
  isPublished      Boolean          @default(true)

  // Content URLs / Files
  videoUrl         String?
  driveFileId      String? // Drive fileId — NOT a public link
  driveFileName    String?
  pdfUrl           String?
  pdfFileName      String?

  // Quizzes & Exams relations
  assignmentQuizId String?
  assignmentQuiz   Quiz?   @relation("LessonAssignment", fields: [assignmentQuizId], references: [id])

  examQuizId       String?
  examQuiz         Quiz?   @relation("LessonExam", fields: [examQuizId], references: [id])

  openingQuizId    String?
  openingQuiz      Quiz?   @relation("OpeningQuiz", fields: [openingQuizId], references: [id])

  homeworkId       String?
  homework         Quiz?   @relation("Homework", fields: [homeworkId], references: [id])

  // Relations
  unlockedBy           UnlockedLesson[]
  subscriptions        LessonSubscription[]
  paymentTransactions  PaymentTransaction[]
  pointsTransactions   PointsTransaction[]
  videoAccessLogs      VideoAccessLog[]
  playbackTokens       PlaybackToken[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([teacherProfileId])
  @@index([courseId])
  @@index([chapterId])
  @@index([academicStage])
  @@index([orderIndex])
}

// ─────────────────────────────────────────────
// LESSON SUBSCRIPTIONS (Single Source of Truth)
// ─────────────────────────────────────────────

model LessonSubscription {
  id               String         @id @default(cuid())
  studentId        String
  student          User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId         String
  lesson           Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  courseId         String?
  course           Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  academicStage    AcademicStage  @default(SECONDARY_1)
  status           String         @default("ACTIVE") // ACTIVE, EXPIRED, REFUNDED, REVOKED
  paymentMethod    String         @default("WALLET_EGP") // WALLET_EGP, POINTS, FREE, ADMIN_GRANT
  pricePaid        Float          @default(0.0)
  pointsPaid       Int            @default(0)
  subscribedAt     DateTime       @default(now())
  expiresAt        DateTime?

  paymentTransaction PaymentTransaction?

  @@unique([studentId, lessonId])
  @@index([studentId, status])
  @@index([teacherProfileId, academicStage])
  @@index([lessonId])
}

// ─────────────────────────────────────────────
// TRACEABLE PAYMENT TRANSACTIONS (Financial Ledger)
// ─────────────────────────────────────────────

model PaymentTransaction {
  id                   String              @id @default(cuid())
  transactionNumber    String              @unique
  studentId            String
  student              User                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherProfileId     String
  teacherProfile       TeacherProfile      @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  academicStage        AcademicStage       @default(SECONDARY_1)
  courseId             String?
  course               Course?             @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lessonId             String?
  lesson               Lesson?             @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  lessonSubscriptionId String?             @unique
  lessonSubscription   LessonSubscription? @relation(fields: [lessonSubscriptionId], references: [id], onDelete: SetNull)
  amount               Float               @default(0.0)
  currency             String              @default("EGP")
  pointsUsed           Int                 @default(0)
  paymentMethod        String              @default("WALLET_EGP")
  teacherEarning       Float               @default(0.0)
  platformFee          Float               @default(0.0)
  status               String              @default("COMPLETED") // PENDING, COMPLETED, FAILED, REFUNDED
  createdAt            DateTime            @default(now())

  @@index([studentId])
  @@index([teacherProfileId, academicStage])
  @@index([createdAt])
}

model UnlockedLesson {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId   String
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  unlockedAt DateTime @default(now())

  @@unique([studentId, lessonId])
  @@index([studentId])
}

model PlaybackToken {
  id        String    @id @default(cuid())
  token     String    @unique
  lessonId  String
  lesson    Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([lessonId])
}

model VideoAccessLog {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  ip        String
  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([lessonId])
}

// ─────────────────────────────────────────────
// QUIZ & EXAM ENGINE
// ─────────────────────────────────────────────

model Quiz {
  id        String         @id @default(cuid())
  title     String
  type      QuizType       @default(EXAM)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  assignmentForLessons Lesson[] @relation("LessonAssignment")
  examForLessons       Lesson[] @relation("LessonExam")
  openingForLessons    Lesson[] @relation("OpeningQuiz")
  homeworkForLessons   Lesson[] @relation("Homework")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuizQuestion {
  id            String       @id @default(cuid())
  quizId        String
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionType  QuestionType @default(MULTIPLE_CHOICE)
  questionText  String
  
  // Multiple Choice fields
  optionA       String?
  optionB       String?
  optionC       String?
  optionD       String?
  correctOption String? // 'A' | 'B' | 'C' | 'D'
  
  // Math / Equation question
  equationLatex String?
  
  // Essay question rubric / sample answer
  sampleAnswer  String?
  rubric        String?

  orderIndex    Int             @default(0)
  answerLines   AttemptAnswer[]

  @@index([quizId])
}

model QuizAttempt {
  id             String          @id @default(cuid())
  studentId      String
  student        User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quizId         String
  quiz           Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score          Int             @default(0)
  totalQuestions Int             @default(0)
  passed         Boolean         @default(false)
  submittedAt    DateTime        @default(now())
  answers        AttemptAnswer[]

  @@unique([studentId, quizId])
  @@index([studentId])
  @@index([quizId])
}

model AttemptAnswer {
  id             String       @id @default(cuid())
  attemptId      String
  attempt        QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  question       QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption String? // 'A' | 'B' | 'C' | 'D'
  textAnswer     String? // Essay / Equation input
  isCorrect      Boolean      @default(false)

  @@index([attemptId])
}

model HomeworkSubmission {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId    String
  submittedAt DateTime @default(now())

  @@unique([studentId, lessonId])
  @@index([studentId])
}

// ─────────────────────────────────────────────
// PLATFORM SETTINGS (Branding & Global Controls)
// ─────────────────────────────────────────────

model PlatformSettings {
  id                          String   @id @default(cuid())
  platformName                String   @default("خطوة")
  platformSubtitle            String?  @default("منصة التعليم الذكية")
  logoUrl                     String?
  primaryColor                String   @default("#6C63FF")
  secondaryColor              String   @default("#FF6584")
  accentColor                 String   @default("#F59E0B")
  fontFamily                  String   @default("Inter")
  pointsToEgpRate             Float    @default(1.0)
  defaultTeacherCommissionPct Float    @default(80.0)
  maintenanceMode             Boolean  @default(false)
  updatedAt                   DateTime @updatedAt
  updatedById                 String?
}
