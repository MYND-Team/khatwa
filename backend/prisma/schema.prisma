// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  STUDENT
  TEACHER
  STAFF
  ADMIN
}

enum ParentStatus {
  BOTH_ALIVE
  FATHER_DECEASED
  MOTHER_DECEASED
  BOTH_DECEASED
}

enum AccessCodeStatus {
  ACTIVE
  REDEEMED
  REVOKED
  EXPIRED
}

enum PointsTransactionType {
  CREDIT
  DEBIT
}

enum QuizType {
  OPENING_QUIZ
  HOMEWORK
  EXAM
}

// ─────────────────────────────────────────────
// ACCESS CODES (Points Access Codes)
// Generated by STAFF / ADMIN -> Redeemed by STUDENT
// ─────────────────────────────────────────────

model AccessCode {
  id           String           @id @default(cuid())
  codeHash     String           @unique // SHA-256 of the uppercase code; plaintext never stored in DB
  points       Int              @default(0)
  status       AccessCodeStatus @default(ACTIVE)
  expiresAt    DateTime?
  createdById  String?
  createdBy    User?            @relation("CreatedAccessCodes", fields: [createdById], references: [id])
  redeemedById String?
  redeemedBy   User?            @relation("RedeemedAccessCodes", fields: [redeemedById], references: [id])
  redeemedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  transactions PointsTransaction[]

  @@index([codeHash])
  @@index([createdById])
  @@index([redeemedById])
  @@index([status])
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Student-only fields
  studentProfile StudentProfile?

  // Teacher-only fields
  teacherProfile TeacherProfile?

  // Auth
  refreshTokens RefreshToken[]

  // Points
  pointsBalance       Int                 @default(0)
  pointsTransactions  PointsTransaction[] @relation("StudentTransactions")
  actedTransactions   PointsTransaction[] @relation("ActorTransactions")

  // Access codes created (STAFF / ADMIN) and redeemed (STUDENT)
  createdAccessCodes  AccessCode[]        @relation("CreatedAccessCodes")
  redeemedAccessCodes AccessCode[]        @relation("RedeemedAccessCodes")

  // Video access logs
  videoAccessLogs VideoAccessLog[]

  // Quiz attempts
  quizAttempts QuizAttempt[]

  // Homework submissions
  homeworkSubmissions HomeworkSubmission[]

  // Unlocked lessons
  unlockedLessons UnlockedLesson[]

  @@index([role])
}

model StudentProfile {
  id                 String       @id @default(cuid())
  userId             String       @unique
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentPhoneNumber String
  parentInfo         ParentInfo?
}

model ParentInfo {
  id                String         @id @default(cuid())
  studentProfileId  String         @unique
  studentProfile    StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  parentPhoneNumber String
  parentEmail       String?
  fatherJob         String
  parentStatus      ParentStatus // SENSITIVE — never include in general API responses
}

model TeacherProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  bio         String?
  lessons     Lesson[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// ─────────────────────────────────────────────
// POINTS / TRANSACTIONS
// ─────────────────────────────────────────────

model PointsTransaction {
  id               String                @id @default(cuid())
  studentId        String
  student          User                  @relation("StudentTransactions", fields: [studentId], references: [id])
  type             PointsTransactionType
  amount           Int
  reason           String
  relatedCodeId    String?
  relatedCode      AccessCode?           @relation(fields: [relatedCodeId], references: [id])
  relatedLessonId  String?
  relatedLesson    Lesson?               @relation(fields: [relatedLessonId], references: [id])
  actorId          String
  actor            User                  @relation("ActorTransactions", fields: [actorId], references: [id])
  createdAt        DateTime              @default(now())

  @@index([studentId])
  @@index([relatedCodeId])
}

// ─────────────────────────────────────────────
// LESSONS
// ─────────────────────────────────────────────

model Lesson {
  id               String         @id @default(cuid())
  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  pointCost        Int            @default(0)
  orderIndex       Int            @default(0)
  isPublished      Boolean        @default(false)

  // Google Drive storage
  driveFileId   String? // Drive fileId — NOT a public link
  driveFileName String?

  openingQuizId String?
  openingQuiz   Quiz?   @relation("OpeningQuiz", fields: [openingQuizId], references: [id])

  homeworkId String?
  homework   Quiz?   @relation("Homework", fields: [homeworkId], references: [id])

  // Relations
  unlockedBy         UnlockedLesson[]
  pointsTransactions PointsTransaction[]
  videoAccessLogs    VideoAccessLog[]
  playbackTokens     PlaybackToken[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([teacherProfileId])
  @@index([orderIndex])
}

model UnlockedLesson {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId   String
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  unlockedAt DateTime @default(now())

  @@unique([studentId, lessonId])
  @@index([studentId])
}

model PlaybackToken {
  id        String    @id @default(cuid())
  token     String    @unique
  lessonId  String
  lesson    Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([lessonId])
}

model VideoAccessLog {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  ip        String
  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([lessonId])
}

// ─────────────────────────────────────────────
// QUIZ ENGINE
// ─────────────────────────────────────────────

model Quiz {
  id        String         @id @default(cuid())
  title     String
  type      QuizType
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  openingForLessons  Lesson[] @relation("OpeningQuiz")
  homeworkForLessons Lesson[] @relation("Homework")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuizQuestion {
  id            String          @id @default(cuid())
  quizId        String
  quiz          Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionText  String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String // 'A' | 'B' | 'C' | 'D'
  orderIndex    Int             @default(0)

  answerLines AttemptAnswer[]

  @@index([quizId])
}

model QuizAttempt {
  id             String          @id @default(cuid())
  studentId      String
  student        User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quizId         String
  quiz           Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score          Int
  totalQuestions Int
  passed         Boolean
  submittedAt    DateTime        @default(now())
  answers        AttemptAnswer[]

  @@unique([studentId, quizId])
  @@index([studentId])
  @@index([quizId])
}

model AttemptAnswer {
  id             String       @id @default(cuid())
  attemptId      String
  attempt        QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  question       QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption String // 'A' | 'B' | 'C' | 'D'
  isCorrect      Boolean

  @@index([attemptId])
}

model HomeworkSubmission {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId    String
  submittedAt DateTime @default(now())

  @@unique([studentId, lessonId])
  @@index([studentId])
}

// ─────────────────────────────────────────────
// PLATFORM SETTINGS (Branding)
// ─────────────────────────────────────────────

model PlatformSettings {
  id             String   @id @default(cuid())
  logoUrl        String?
  primaryColor   String   @default("#6C63FF")
  secondaryColor String   @default("#FF6584")
  fontFamily     String   @default("Inter")
  updatedAt      DateTime @updatedAt
  updatedById    String?
}
