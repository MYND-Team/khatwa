# ==============================================================================
# Khatwa Platform — Environment Configuration (.env.example)
# Copy this file to .env or configure these variables in your Vercel Project Settings
# ==============================================================================

# Server
PORT=3000
NODE_ENV=production

# Database (PostgreSQL - Neon, Supabase, Railway, Vercel Postgres, etc.)
DATABASE_URL="postgresql://username:password@your-postgres-host:5432/khatwa?sslmode=require"

# JWT Authentication Secrets (Must be at least 32 characters each)
JWT_ACCESS_SECRET="your_secure_jwt_access_secret_key_at_least_32_chars_long"
JWT_REFRESH_SECRET="your_secure_jwt_refresh_secret_key_at_least_32_chars_long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Playback Token Secret for Video Security
PLAYBACK_TOKEN_SECRET="your_playback_token_secret_min_32_chars_long"
PLAYBACK_TOKEN_TTL_SECONDS=300

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# CORS Allowed Origins (Comma-separated list of domains allowed to make cross-origin requests)
# Example: https://khatwa.vercel.app,https://mynd-khatwa.com
ALLOWED_ORIGINS="https://your-domain.vercel.app"

# Google Drive Integration (Optional for Video Uploads)
GOOGLE_DRIVE_ROOT_FOLDER_ID="your_google_drive_folder_id"
GOOGLE_OAUTH_CLIENT_JSON_PATH="secrets/google-oauth-client.json"
GOOGLE_DRIVE_TOKEN_PATH="secrets/google-drive-token.json"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/auth/google/callback"
